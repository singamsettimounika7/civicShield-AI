# CivicShield AI Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Database Configuration
DATABASE_URL=sqlite:///./civicshield.db

# JWT Authentication Secret
SECRET_KEY=civicshield-ai-demo-secret-key-super-secure-2025

# Optional Real AI Provider Keys
# If left blank, CivicShield automatically activates the transparent,
# deterministic Community Risk Intelligence Engine fallback with 0 paid API costs.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Port Settings
BACKEND_PORT=8000
FRONTEND_PORT=3000
